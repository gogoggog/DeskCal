{
  "name": "deskcal",
  "productName": "DeskCal",
  "version": "0.9.1",
  "description": "바탕화면 달력 — 윈도우·맥 (아이클라우드·구글 캘린더 연동, 월별 메모, 일정 검색)",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --arm64 --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "node-ical": "0.27.3",
    "tsdav": "^2.5.0"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.deskcal.app",
    "productName": "DeskCal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "artifactName": "DeskCal-Windows.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "DeskCal",
      "artifactName": "DeskCal-Setup.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallDisplayName": "DeskCal 달력"
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "publish": {
      "provider": "github",
      "owner": "gogoggog",
      "repo": "deskcal"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "DeskCal-Mac-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true,
        "NSHumanReadableCopyright": "DeskCal"
      }
    },
    "dmg": {
      "title": "DeskCal",
      "artifactName": "DeskCal-Mac-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gogoggog/deskcal.git"
  }
}
